# Copy this file to .env and fill in the values.
# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
# Claude uses your Claude Code Pro subscription login, so no API key is needed.
# Claude는 Claude Code의 Pro 구독 로그인을 사용하므로 API 키가 필요 없습니다.
NOTION_TOKEN=ntn_...
NOTION_DATABASE_ID=

# Optional
# 선택 사항

# Empty = PC timezone in the extension, Asia/Seoul on the command line
# 비우면 확장은 PC 시간대, 명령줄은 Asia/Seoul
# TIMEZONE=Asia/Seoul

# First day of the week: sunday, monday (default), tuesday, wednesday, thursday, friday, saturday
# 한 주의 시작 요일: sunday, monday(기본), tuesday, wednesday, thursday, friday, saturday
# WEEK_START=monday

# Empty = Claude Code's default model (opus, sonnet, haiku, ...)
# 비우면 Claude Code 기본 모델 (opus, sonnet, haiku 등)
# CLAUDE_MODEL=sonnet

# Empty = auto-detect
# 비우면 자동 감지
# NOTION_TITLE_PROPERTY=Name

# Empty = first date property
# 비우면 첫 번째 날짜 속성 사용
# NOTION_DATE_PROPERTY=Date

# Text property. Empty = notes go into the page body
# 텍스트 속성. 비우면 메모는 페이지 본문에 기록
# NOTION_DESCRIPTION_PROPERTY=Notes

# Text property for the location. Empty = auto-detect a text property named Location / 위치 / 장소
# 장소를 적을 텍스트 속성. 비우면 'Location'/'위치'/'장소' 텍스트 속성 자동 감지
# NOTION_LOCATION_PROPERTY=Location
